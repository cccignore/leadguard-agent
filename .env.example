# Copy this file to .env. Never commit a real key.

# Default: any OpenAI-compatible gateway (OpenLux shown as the verified example).
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openlux.ai/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-5.6-luna

# Alternative: official Gemini Developer API.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional: protect reactivate/reset/diagnostics with an operator token.
# OPERATOR_TOKEN=choose-a-long-random-string

DATABASE_PATH=data/leadguard.db
RATE_LIMIT_SECONDS=60
MODEL_TIMEOUT_SECONDS=60
